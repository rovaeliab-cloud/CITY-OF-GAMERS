{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/", "destination": "/api/tienda?__recurso=/" },
    { "source": "/:ruta*", "destination": "/api/tienda?__recurso=/:ruta*" }
  ]
}
